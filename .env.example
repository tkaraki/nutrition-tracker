# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed — this file (.env.example)
# is the one that's safe to publish, with placeholders only.

NODE_ENV=development
PORT=3000

# Postgres connection. Locally this points at the `nutrition_app` role
# created during setup, against the `nutrition_tracker_dev` database.
DATABASE_URL=postgresql://nutrition_app:REPLACE_ME@localhost:5432/nutrition_tracker_dev

# Session signing secret. Generate your own with:
#   openssl rand -base64 48
SESSION_SECRET=REPLACE_ME

# USDA FoodData Central API key (free): https://fdc.nal.usda.gov/api-key-signup
FDC_API_KEY=REPLACE_ME

# LLM provider for recipe parsing + the AI coach. Set one:
#   OLLAMA_BASE_URL for a local model, or GEMINI_API_KEY for hosted Gemini Flash.
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
